{
  "$id": "slack-minutes-payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["channelId", "message", "canvasTitle", "canvasMarkdown", "taskLinks"],
  "properties": {
    "channelId": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "canvasTitle": { "type": "string", "minLength": 1 },
    "canvasMarkdown": { "type": "string", "minLength": 1 },
    "taskLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
